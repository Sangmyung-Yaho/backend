# 구글 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# 소셜 로그인 성공 후 리다이렉트할 프론트엔드 주소
FRONTEND_REDIRECT_URI=http://localhost:3000/oauth/success
