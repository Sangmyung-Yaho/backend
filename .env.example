# Database
DB_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# JWT
JWT_SECRET=

# Redis (미설정 시 기본값: localhost / 6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# 카카오 로그인
